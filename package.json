{
  "name": "@substrate-system/envelope",
  "version": "0.3.5",
  "type": "module",
  "description": "Envelopes that have been authorized by the recipient",
  "directories": {
    "test": "test"
  },
  "main": "dist/index.js",
  "files": [
    "./dist/*"
  ],
  "scripts": {
    "lint": "eslint \"./**/*.{ts,js}\"",
    "test": "esbuild ./test/index.ts --target=es2020 --bundle --keep-names | tapout --browser chrome",
    "build-cjs": "esbuild src/*.ts --format=cjs --keep-names --outdir=./dist --out-extension:.js=.cjs",
    "build": "mkdir -p ./dist && rm -rf ./dist/* && npm run build-cjs && tsc --project tsconfig.build.json",
    "toc": "markdown-toc --maxdepth 3 -i README.md",
    "preversion": "npm run lint",
    "version": "npm run toc && auto-changelog -p --template keepachangelog --breaking-pattern 'BREAKING CHANGE:' && git add CHANGELOG.md",
    "postversion": "git push && git push --tags && npm publish",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@substrate-system/keys": "^0.2.43",
    "@substrate-system/message": "^0.11.5",
    "json-canon": "^1.0.1",
    "uint8arrays": "^6.1.1"
  },
  "devDependencies": {
    "@substrate-system/tapout": "^0.0.41",
    "@substrate-system/tapzero": "^0.10.13",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "auto-changelog": "^2.4.0",
    "esbuild": "^0.28.1",
    "eslint": "^8.57.0",
    "eslint-config-standard": "^17.1.0",
    "markdown-toc": "^1.2.0",
    "typescript": "^6.0.3"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./*": {
      "import": [
        "./dist/*.js",
        "./dist/*"
      ],
      "require": [
        "./dist/*.cjs",
        "./dist/*"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/substrate-system/envelope.git"
  },
  "keywords": [
    "envelope",
    "cryptography",
    "encrypt",
    "browser"
  ],
  "bugs": {
    "url": "https://github.com/substrate-system/envelope/issues"
  },
  "homepage": "https://github.com/substrate-system/envelope",
  "author": "nichoth <nichoth@nichoth.com> (https://nichoth.com)",
  "license": "SEE LICENSE IN LICENSE"
}
